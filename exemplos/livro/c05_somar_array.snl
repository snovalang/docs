package livro.somararray

import builtin.io.console

func somar(valores: int[]): int {
    var total = 0
    var i = 0
    while i < valores.len() {
        total = total + valores[i]
        i = i + 1
    }
    return total
}

func main(): int {
    let total = somar([5, 6, 7])
    Console.printline(total)
    return total
}
